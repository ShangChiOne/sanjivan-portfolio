# Copy this file to `.env` (or otherwise export these as real environment variables
# before running app.py) and fill in real values. Nothing in this file is loaded
# automatically -- app.py reads via os.environ.get(...) with the defaults shown below.

# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-in-production

# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DATABASE=fyp_forecasting

# ── Ollama connection ────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Ollama sampling options (chat_engine.deterministic_ollama_options) ──────────
# Applied to every Ollama call the app makes (chart-view classification, chart
# insight commentary, column/vocab mapping suggestions, and the general chat reply).
# These make model output more repeatable, but are NOT treated as a correctness
# guarantee anywhere in the app -- factual answers (rankings, chart data, numbers)
# are always computed deterministically in Python/SQL and never trusted from the
# model; LLM-authored chart commentary is additionally validated against the exact
# chart data before being shown (see chat_engine.validate_chart_narrative), and
# discarded in favor of a deterministic template on any mismatch.
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
# Context window in tokens. 8192 is a reasonable default for llama3.2 3B on modest
# hardware -- raise it if you swap in a model/GPU that comfortably supports more.
OLLAMA_NUM_CTX=8192
# Max tokens the model may generate per call (chart insights / general chat replies
# are short by design; raised at the one call site -- the general chat fallback --
# that benefits from more room).
OLLAMA_NUM_PREDICT=400
